  "components": [
    {
      "name": "主操作",
      "kind": "button",
      "description": "权限与状态处理的普通主操作。",
      "html": "<button class=\"ds-primary\">确认</button>",
      "css": ".ds-primary{font:inherit;min-height:44px;padding:0 16px;border:0;border-radius:13px;background:var(--accent,#2172d6);color:#fff;font-size:13px;font-weight:550;cursor:pointer;transition:background-color 160ms,color 160ms,opacity 160ms}.ds-primary:hover{background:var(--accent-hover,#1762c1)}.ds-primary:focus-visible{outline:2px solid var(--focus,#327fe7);outline-offset:4px}:host-context([data-theme=dark]) .ds-primary{color:#102039}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}",
      "refersTo": "button-primary"
    },
    {
      "name": "次操作",
      "kind": "button",
      "description": "选定工具行的补充操作。",
      "html": "<button class=\"ds-secondary\">打开方式</button>",
      "css": ".ds-secondary{font:inherit;min-height:44px;padding:0 16px;background:var(--panel,#fff);color:var(--ink,#252536);border:0;border-radius:13px;font-size:13px;font-weight:550;cursor:pointer}.ds-secondary:hover{background:var(--hover,#ededf7)}.ds-secondary:focus-visible{outline:2px solid var(--focus,#327fe7);outline-offset:4px}",
      "refersTo": "button-secondary"
    },
    {
      "name": "当前导航",
      "kind": "nav",
      "description": "桌面侧栏的选中导航。",
      "html": "<button class=\"ds-nav\" aria-current=\"page\">连接</button>",
      "css": ".ds-nav{font:inherit;min-height:46px;border:0;border-radius:14px;padding:0 14px;color:var(--accent-ink,#246ec5);background:var(--accent-soft,#e9f2ff);font-size:13px;font-weight:550;cursor:pointer}.ds-nav:hover{background:var(--hover,#ededf7)}.ds-nav:focus-visible{outline:2px solid var(--focus,#327fe7);outline-offset:4px}"
    },
    {
      "name": "只读状态",
      "kind": "chip",
      "description": "标签为信息，不是选择出口的控件。",
      "html": "<span class=\"ds-status\">服务端绑定</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:6px;font:inherit;font-size:12px;padding:4px 7px;border-radius:6px;color:var(--good,#228268);background:var(--good-soft,#e8f6ef)}"
    },
    {
      "name": "柔和面板",
      "kind": "card",
      "description": "采用圆润表面与下方柔和投影。",
      "html": "<section class=\"ds-panel\"><h2>常用工具</h2></section>",
      "css": ".ds-panel{font:inherit;padding:22px 18px 18px;color:var(--ink,#252536);background:var(--panel,#fff);border:0;border-radius:26px;box-shadow:var(--panel-shadow,0 10px 30px rgba(82,78,136,.055))}.ds-panel h2{font-size:16px;line-height:1.4;font-weight:650;margin:0}@media(max-width:560px){.ds-panel{padding:20px 10px 14px;border-radius:24px}}",
      "refersTo": "panel"
    },
    {
      "name": "立体工具图标",
      "kind": "custom",
      "description": "渐变、内侧高光和投影形成厚度；SVG保持清晰。",
      "html": "<button class=\"ds-tile\"><span class=\"ds-dimensional\"><span class=\"ds-inlay\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"m5 7 5 5-5 5m8 0h6\"/></svg></span></span><strong>Claude Code</strong></button>",
      "css": ".ds-tile{font:inherit;display:flex;flex-direction:column;align-items:center;gap:11px;min-height:100px;border:0;background:transparent;color:var(--ink,#252536);border-radius:17px;padding:0 3px 5px;cursor:pointer}.ds-tile:hover{background:var(--layer,#f5f5fa)}.ds-tile:focus-visible{outline:2px solid var(--focus,#327fe7);outline-offset:4px}.ds-tile strong{font-size:12px;font-weight:550}.ds-dimensional{position:relative;display:grid;place-items:center;width:58px;height:58px;border-radius:18px;background:linear-gradient(145deg,#539fff,#2b7fec);box-shadow:0 7px 12px rgba(45,132,239,.2);overflow:hidden}.ds-dimensional::before{content:\"\";position:absolute;inset:1px;border-radius:17px;box-shadow:inset 0 1px 1px rgba(255,255,255,.4);pointer-events:none}.ds-inlay{width:35px;height:35px;border-radius:10px;background:linear-gradient(145deg,rgba(255,255,255,.55),rgba(255,255,255,.13));display:grid;place-items:center;color:#fff}.ds-inlay svg{width:23px;height:23px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}@media(max-width:560px){.ds-dimensional{width:51px;height:51px;border-radius:16px}.ds-inlay{width:32px;height:32px;border-radius:9px}}"
    },
    {
      "name": "连接胶囊",
      "kind": "custom",
      "description": "桌面底部胶囊；手机同一动作移到五位置 Dock 中央凸起。",
      "html": "<div class=\"ds-dock\"><button class=\"ds-connect\"><span class=\"ds-connect-symbol\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"M12 3v9m-6.4-6.4a9 9 0 1 0 12.8 0\"/></svg></span>连接</button></div>",
      "css": ".ds-dock{display:flex;justify-content:center;width:180px;min-height:64px;padding:8px 12px;border-radius:24px;background:var(--panel,#fff);box-shadow:0 10px 28px rgba(59,55,111,.1)}.ds-connect{font:inherit;display:flex;align-items:center;justify-content:center;gap:10px;width:100%;min-height:48px;padding:0;border:0;background:transparent;color:var(--accent-ink,#246ec5);font-size:13px;font-weight:550;cursor:pointer}.ds-connect:focus-visible{outline:2px solid var(--focus,#327fe7);outline-offset:4px}.ds-connect-symbol{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(145deg,#459aff,#2478f0);color:#fff;box-shadow:0 4px 10px rgba(40,126,239,.2)}.ds-connect-symbol svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:2.1;stroke-linecap:round;stroke-linejoin:round}.ds-connect:hover .ds-connect-symbol{filter:brightness(1.07)}.ds-connect:active{transform:scale(.97)}@media(prefers-reduced-motion:reduce){.ds-connect{transition:none}}"
    },
    {
      "name": "应用分类筛选",
      "kind": "custom",
      "description": "少量应用按类别直接选择，不提供搜索。",
      "html": "<div class=\"ds-filters\"><button class=\"ds-filter\" aria-pressed=\"true\">全部</button><button class=\"ds-filter\" aria-pressed=\"false\">编程</button><button class=\"ds-clear\">清空搜索</button></div>",
      "css": ".ds-filters{display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin:18px 0 4px}.ds-filter{font:inherit;border:0;min-height:44px;border-radius:16px;padding:0 16px;font-size:13px;color:var(--muted,#666679);background:transparent;cursor:pointer}.ds-filter:hover{background:var(--hover,#ededf7)}.ds-filter[aria-pressed=true]{background:var(--panel,#fff);color:var(--accent-ink,#246ec5);font-weight:600;box-shadow:var(--panel-shadow,0 10px 30px rgba(82,78,136,.055))}.ds-filter:focus-visible{outline:2px solid var(--focus,#327fe7);outline-offset:4px}@media(max-width:560px){.ds-filters{gap:4px}.ds-filter{padding:0 12px}}"
    },
    {
      "name": "我的账号面板",
      "kind": "card",
      "description": "显示主站真实资料与登录入口；未订阅如实显示，模拟身份不覆盖账号。",
      "html": "<section class=\"ds-account\"><span class=\"ds-avatar\">访</span><div><strong>访客</strong><p>未登录</p></div><button class=\"ds-manage\">登录 / 注册</button></section>",
